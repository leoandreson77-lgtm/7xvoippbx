{
  "name": "krad-global-agent-system",
  "version": "1.0.0",
  "description": "FreeSWITCH + SIP + WebRTC Agent Login & Call Center System",
  "main": "src/server.js",
  "scripts": {
    "build": "vite build",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:setup": "npx prisma db push && node prisma/seed.js",
    "docker:image": "docker build -t leoaddre/7xvoip:latest .",
    "docker:push": "docker build -t leoaddre/7xvoip:latest . && docker push leoaddre/7xvoip:latest",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.33.0",
    "modesl": "^1.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sip.js": "^0.21.2",
    "uuid": "^10.0.0",
    "vue": "^3.5.41",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "vite": "^8.2.2"
  }
}

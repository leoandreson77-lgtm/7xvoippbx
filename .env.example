# ── Server ──────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── JWT ─────────────────────────────────────────
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars
JWT_EXPIRY=15m

# ── FreeSWITCH ESL ─────────────────────────────
ESL_HOST=127.0.0.1
ESL_PORT=8021
ESL_PASSWORD=ClueCon

# ── FreeSWITCH SIP ─────────────────────────────
SIP_DOMAIN=kradglobal.com
SIP_WSS_URL=wss://kradglobal.com:7443
STUN_SERVER=stun:stun.l.google.com:19302

# ── SIP Trunk (fill in your provider details) ──
SIP_TRUNK_HOST=sip.provider.com
SIP_TRUNK_USERNAME=your-trunk-username
SIP_TRUNK_PASSWORD=your-trunk-password
SIP_TRUNK_DID=+911234567890

# ── Database ────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Rate Limiting ───────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

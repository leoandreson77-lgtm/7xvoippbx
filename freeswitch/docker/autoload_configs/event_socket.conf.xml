<!--
  FreeSWITCH Event Socket Configuration (Docker Container)
  
  Allows the Node.js backend container to connect via ESL.
  Listens on 0.0.0.0 to accept connections from the Docker bridge network.
-->
<configuration name="event_socket.conf" description="Socket Client">
  <settings>
    <param name="nat-map" value="false"/>
    <param name="listen-ip" value="0.0.0.0"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="ClueCon"/>
    <param name="apply-inbound-acl" value="any_custom.auto"/>
  </settings>
</configuration>

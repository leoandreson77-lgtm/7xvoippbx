<!--
  FreeSWITCH Event Socket Configuration
  
  This allows the Node.js backend to connect to FreeSWITCH via ESL.
  
  Copy to: /etc/freeswitch/autoload_configs/event_socket.conf.xml
  
  SECURITY: 
  - Change the password from 'ClueCon' to a strong random value.
  - If Node.js is on the same server, use listen-ip="127.0.0.1".
  - If Node.js is on a different server, restrict with firewall rules.
-->
<configuration name="event_socket.conf" description="Socket Client">
  <settings>
    <param name="nat-map" value="false"/>
    <param name="listen-ip" value="127.0.0.1"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="ClueCon"/>
    <param name="apply-inbound-acl" value="loopback.auto"/>
  </settings>
</configuration>

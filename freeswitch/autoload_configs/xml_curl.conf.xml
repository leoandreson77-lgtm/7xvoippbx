<!--
  mod_xml_curl Configuration
  
  This tells FreeSWITCH to fetch directory (user/extension) information
  from the Node.js backend API instead of static XML files.
  
  Copy to: /etc/freeswitch/autoload_configs/xml_curl.conf.xml
  
  IMPORTANT: The URL must point to your running Node.js backend.
  If FreeSWITCH and Node.js are on the same server, use localhost.
-->
<configuration name="xml_curl.conf" description="cURL XML Gateway">
  <bindings>
    <binding name="krad-directory">
      <!-- 
        Only directory section is dynamic.
        Dialplan and configuration remain as static XML.
      -->
      <param name="gateway-url" value="http://127.0.0.1:3000/fs-config"/>
      <param name="bindings" value="directory"/>
      <param name="timeout" value="5"/>
      <param name="connect-timeout" value="3"/>
      <!-- Optional: Disable SSL verification for localhost -->
      <param name="disable-100-continue" value="true"/>
    </binding>
  </bindings>
</configuration>

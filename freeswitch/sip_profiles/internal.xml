<!--
  FreeSWITCH Internal SIP Profile — WebRTC Enabled
  
  This profile handles local extension registrations via SIP/WebSocket.
  Copy this file to: /etc/freeswitch/sip_profiles/internal.xml
  (or your FreeSWITCH's conf/sip_profiles/ directory)
  
  IMPORTANT: Replace "kradglobal.com" with your actual domain.
  IMPORTANT: Valid TLS certificates are required for WSS.
-->
<profile name="internal">
  <aliases>
    <alias name="7xvoip.com"/>
  </aliases>

  <gateways>
    <!--
      Twilio SIP Trunk Gateway (7xvoip)
      Used for outbound PSTN calls via Twilio Programmable Voice
    -->
    <gateway name="sip-trunk">
      <param name="username" value="7xvoip"/>
      <param name="password" value="7Xvoip@22001!"/>
      <param name="realm" value="7xvoip.sip.twilio.com"/>
      <param name="proxy" value="7xvoip.pstn.twilio.com"/>
      <param name="register" value="false"/>
      <param name="caller-id-in-from" value="true"/>
      <param name="retry-seconds" value="30"/>
      <param name="expire-seconds" value="3600"/>
    </gateway>

    <!--
      Twilio Elastic SIP Trunking Gateway (Termination)
      Alternative outbound path referenced in dialplan
    -->
    <gateway name="trunk-twilio-elastic">
      <param name="username" value="7xvoip"/>
      <param name="password" value="7Xvoip@22001!"/>
      <param name="realm" value="7xvoip.pstn.twilio.com"/>
      <param name="proxy" value="7xvoip.pstn.twilio.com"/>
      <param name="register" value="false"/>
      <param name="caller-id-in-from" value="true"/>
      <param name="retry-seconds" value="30"/>
      <param name="expire-seconds" value="3600"/>
    </gateway>
  </gateways>

  <domains>
    <domain name="all" alias="true" parse="false"/>
  </domains>

  <settings>
    <!-- ── Core SIP Settings ──────────────────── -->
    <param name="context" value="default"/>
    <param name="dialplan" value="XML"/>
    <param name="rtp-ip" value="auto"/>
    <param name="sip-ip" value="auto"/>
    <param name="ext-rtp-ip" value="auto-nat"/>
    <param name="ext-sip-ip" value="auto-nat"/>
    
    <!-- ── SIP Bindings ───────────────────────── -->
    <param name="sip-port" value="5060"/>
    <param name="hold-music" value="$${hold_music}"/>
    
    <!-- ── WebSocket Bindings (for WebRTC) ────── -->
    <param name="ws-binding" value="0.0.0.0:5066"/>
    <param name="wss-binding" value="0.0.0.0:7443"/>
    
    <!-- ── TLS Configuration ──────────────────── -->
    <param name="tls" value="true"/>
    <param name="tls-bind-params" value="transport=tls"/>
    <param name="tls-sip-port" value="5061"/>
    <param name="tls-version" value="tlsv1.2"/>
    
    <!--
      TLS Certificate Paths
      For Let's Encrypt: 
        cert = /etc/letsencrypt/live/yourdomain/fullchain.pem
        key  = /etc/letsencrypt/live/yourdomain/privkey.pem
      
      For default FreeSWITCH certs (self-signed):
        /etc/freeswitch/tls/
    -->
    <param name="tls-cert-dir" value="/etc/freeswitch/tls/"/>
    
    <!-- ── Codecs ─────────────────────────────── -->
    <param name="inbound-codec-prefs" value="OPUS,G722,PCMU,PCMA"/>
    <param name="outbound-codec-prefs" value="OPUS,G722,PCMU,PCMA"/>
    <param name="inbound-codec-negotiation" value="generous"/>
    
    <!-- ── Authentication ─────────────────────── -->
    <param name="challenge-realm" value="7xvoip.com"/>
    <param name="auth-calls" value="true"/>
    <param name="log-auth-failures" value="true"/>
    
    <!-- ── DTMF ───────────────────────────────── -->
    <param name="dtmf-type" value="rfc2833"/>
    <param name="liberal-dtmf" value="true"/>
    
    <!-- ── NAT / ICE Handling ─────────────────── -->
    <param name="apply-nat-acl" value="nat.auto"/>
    <param name="local-network-acl" value="localnet.auto"/>
    <param name="aggressive-nat-detection" value="true"/>
    <param name="NDLB-received-in-nat-reg-contact" value="true"/>
    <param name="NDLB-force-rport" value="true"/>
    
    <!-- ── WebRTC / Media Settings ────────────── -->
    <param name="rtp-timeout-sec" value="300"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>
    <param name="media-option" value="bypass-media-after-att-xfer"/>
    
    <!-- ── Registration ───────────────────────── -->
    <param name="accept-blind-reg" value="false"/>
    <param name="nonce-ttl" value="60"/>
    <param name="max-registrations-per-extension" value="1"/>
    
    <!-- ── Misc ───────────────────────────────── -->
    <param name="manage-presence" value="true"/>
    <param name="presence-hosts" value="7xvoip.com"/>
    <param name="send-message-query-on-register" value="true"/>
    <param name="user-agent-string" value="7XVOIP-PBX"/>
  </settings>
</profile>

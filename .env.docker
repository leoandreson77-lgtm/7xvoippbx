# ── Application ───────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Security & Authentication ─────────────────────
JWT_SECRET=krad-global-production-jwt-secret-min-32-chars-long
JWT_EXPIRY=15m

# ── Database (Persistent volume inside container) ─
DATABASE_URL="file:/app/data/app.db"
SEED_DATABASE=true

# ── FreeSWITCH Connection (Docker / EasyPanel) ───
FREESWITCH_HOST=freeswitch_freeswitch
FREESWITCH_PORT=8021
FREESWITCH_PASSWORD=ClueCon

# ── SIP & WebRTC Settings ─────────────────────────
SIP_DOMAIN=kradglobal.com
SIP_WSS_URL=wss://localhost:7443
STUN_SERVER=stun:stun.l.google.com:19302

# ── SIP Trunk Configuration ───────────────────────
SIP_TRUNK_HOST=sip.provider.com
SIP_TRUNK_USERNAME=your-trunk-username
SIP_TRUNK_PASSWORD=your-trunk-password
SIP_TRUNK_DID=+18005550199

# ── Rate Limiting ─────────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
